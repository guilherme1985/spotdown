SPOTIFY_CLIENT_ID=seu_client_id_aqui
SPOTIFY_CLIENT_SECRET=seu_client_secret_aqui

# Tempo máximo (segundos) para buscar uma playlist no Spotify antes de desistir.
# Playlists grandes podem demorar bastante pois cada faixa é casada com o YouTube
# durante a busca. Aumente se estiver recebendo erro de "tempo esgotado".
# SPOTIFY_FETCH_TIMEOUT=150

# UID/GID do seu usuário para os arquivos baixados não ficarem como root.
# Descubra com: id -u  /  id -g  (geralmente 1000 no primeiro usuário Linux)
PUID=1000
PGID=1000
